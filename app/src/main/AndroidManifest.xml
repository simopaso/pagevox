<?xml version="1.0" encoding="utf-8"?>
<!-- The manifest file for the application. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required by the application. -->
    <!-- Allows the app to access the internet. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Allows the app to post notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Allows the app to run as a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Allows the app to run as a foreground service for media playback. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- The application element. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PageVox"
        tools:targetApi="34">
        <!-- The main activity of the application. -->
        <!-- Handle the size and orientation changes ourselves rather than being
             recreated for them. Folding or unfolding a foldable, or rotating,
             would otherwise tear down the activity and with it the WebView:
             the page would reload, the scroll position and any form input would
             be lost, and the reader would have to re-extract the page. Compose
             re-lays-out on a configuration change regardless, and the WebView
             handles one itself, so nothing here depends on being recreated.
             Locale changes are deliberately NOT listed: the per-app language
             picker must recreate the activity to pick up the new resources. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PageVox">
            <!-- The intent filter for the main activity. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Accept text/URLs shared from other apps (Share → PageVox). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Act as a handler for web links ("Open with"). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
        <!-- Receives a headphone / car / Bluetooth Play press once the paused
             playback service is gone. Android stops a paused media service
             within about a minute (it is no longer in the foreground), which
             used to leave the Play button with nothing to talk to. Media3
             registers this receiver with the session, so the system remembers
             it after the session is released; on a press it restarts the
             service, which resumes the last page from its on-disk snapshot
             (PlaybackService.onPlaybackResumption). Must be the only
             MEDIA_BUTTON receiver in the app, or Media3 refuses to pick one. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <!-- The playback service. -->
        <service
            android:name=".PlaybackService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <!-- The intent filter for the playback service. -->
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService"/>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>

</manifest>
