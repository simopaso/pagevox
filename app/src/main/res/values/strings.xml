<resources>
    <!-- Source of truth for every user-visible string. Translations live in
         values-fi / values-sv / values-de / values-fr; anything missing there
         falls back to this file, so a partial translation degrades to English
         rather than crashing.

         Note on time-left wording: the abbreviations "min" and "h" are used
         deliberately. They don't inflect in any of the translated languages, so
         the counts need no plural forms and stay short enough for a list row. -->
    <!-- translatable="false" on the three below is what keeps lint's
         MissingTranslation check quiet about them: a product name, a pure
         number format, and a license name are the same in every language. -->
    <string name="app_name" translatable="false">PageVox</string>

