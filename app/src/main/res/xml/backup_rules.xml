<?xml version="1.0" encoding="utf-8"?><!--
   Back up only PageVox's own settings (the DataStore file holding preferences,
   bookmarks, history, and the reading position). Everything else — notably
   WebView's internal profile (app_webview/: cookies, local storage, session
   state) — must NOT be backed up: restoring it onto a different device or
   WebView build hands the engine corrupt state, which has caused an infinite
   page-reload loop after a device-to-device transfer.
   Note: this file applies to devices below API 31; data_extraction_rules.xml
   covers API 31+.
-->
<full-backup-content>
    <include domain="file" path="datastore/" />
</full-backup-content>
